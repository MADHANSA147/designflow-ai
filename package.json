{
  "name": "designflow-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src/app server tests",
    "test": "tsx --test tests/unit.test.ts tests/server.test.ts",
    "test:e2e": "playwright test",
    "server": "tsx --env-file-if-exists=server/.env server/index.ts",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "android:apk": "powershell -ExecutionPolicy Bypass -File scripts/build-android.ps1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "eslint-plugin-html": "^8.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.0.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.2",
    "zod": "^4.6.5"
  }
}
